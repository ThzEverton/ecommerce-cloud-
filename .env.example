PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD=senha
DB_DATABASE=atividade
DB_CONNECTION_LIMIT=10

OCI_REGION=sa-saopaulo-1
OCI_USE_INSTANCE_PRINCIPAL=true
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT

OCI_BUCKET_NAME=nome-do-bucket
OCI_NAMESPACE=namespace-da-tenancy
OCI_OBJECT_BASE_URL=https://objectstorage.sa-saopaulo-1.oraclecloud.com/n/namespace-da-tenancy/b/nome-do-bucket/o

OCI_QUEUE_ENDPOINT=https://cell-1.queue.messaging.sa-saopaulo-1.oci.oraclecloud.com
OCI_QUEUE_OCID=ocid1.queue.oc1.sa-saopaulo-1.exemplo
OCI_QUEUE_POLL_TIMEOUT=20
OCI_QUEUE_VISIBILITY_TIMEOUT=30

SMTP_HOST=smtp.email.sa-saopaulo-1.oci.oraclecloud.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=senha-smtp
SMTP_FROM=noreply@seudominio.com.br

EMAIL_WORKER_BATCH_SIZE=5
EMAIL_WORKER_POLL_INTERVAL=5000
